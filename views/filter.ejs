<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Szűrés</title>
</head>

<body>

    <h1>Filtered article views</h1>


    <form  method="get">
        <input type="number" name="minViews" placeholder="Minimum views" >
        <button type="submit">Filter</button>
    </form>

    <table>
        <thead>
            <th>Title</th>
            <th>Views</th>
        </thead>

        <tbody>
            <% articleViews.forEach(a=> { %>
                <tr >
                    <td>
                        <a href="<%= a.url %>">
                            <%= a.title %>
                        </a>
                    </td>
                    <td>
                        <%= a.views %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    <br><br>



</body>

</html>